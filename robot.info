  "robot_info_version": "0.1",

  "name": "CronAlarm",
  "tagline": "The cron wrapper that screams when things break — no silent failures, ever.",
  "summary": "CronAlarm wraps every cron job with timeout protection, output capture, and multi-channel alerting. When a job fails or hangs, you hear about it instantly via Discord webhook. A daily report shows what passed, what failed, what recovered — and which scheduled runs never happened at all (a rebooted scheduler swallows slots silently; CronAlarm names them). Bash + python3, no daemon, no server, no database. Designed for the 3 AM backup that breaks silently and goes unnoticed until the data is gone.",
  "version": "2.1",
  "license": "MIT",
  "homepage": "https://github.com/GuyMannDude/cronalarm",
  "source": "https://github.com/GuyMannDude/cronalarm",
  "contact": "guy@projectsparks.ai",
  "maintainer": "Project Sparks",

  "capabilities": [
    "Wrap any cron job: `cronalarm \"Job Name\" /path/to/script.sh` and the wrapper handles the rest.",
    "Timeout protection — configurable per-job (CRONALARM_TIMEOUT, default 300s). Hung jobs get killed and you get alerted.",
    "Captures stdout + stderr + exit code on every run.",
    "Alerts on failure: Discord webhook + local file drop.",
    "Local file drop always on — failure reports land at ~/.cronalarm/inbox/ regardless of which channels are configured. Survives a Discord outage.",
    "Daily report at 11 PM — pass/fail/recovered per job, with closed accounting (passed+failed+timeouts+in-flight must equal started, and a derived and an independently measured in-flight count must agree — a counter that doesn't reconcile forces COUNTER MISMATCH, never green).",
    "Missed-run detection — expected slots are derived from the live crontab and slots with no run at all are reported, split into 'scheduler was down' vs 'unexplained'. A run that never happened is no longer indistinguishable from a run with nothing to report.",
    "Honest staleness — a failure from this morning is labeled 'NOT re-checked (18h29m stale)', never republished as current. Jobs on an explicit read-only allowlist (~/.cronalarm/reverify.map) are re-verified live right before the report composes.",
    "Skim-free routing — ALL CLEAR days append one line to a local green digest instead of posting to a channel someone reads; only non-green days address a reader.",
    "Structured logs — one file per day at ~/.cronalarm/logs/YYYY-MM-DD.log. Greppable, parseable, agent-friendly.",
    "Re-runnable installer — re-running install.sh upgrades the scripts and leaves an existing config file untouched.",
    "Unattended install supported — pass channel config as env vars + `--yes` flag for CI / automation."
  ],

  "exposes": {
    "cli": [
      {"command": "cronalarm \"Job Name\" <command...>", "purpose": "Run a command under CronAlarm's protection. Job name appears in alerts + summaries."},
      {"command": "bash install.sh", "purpose": "Interactive installer. Walks through channel setup (Discord) and writes config to ~/.cronalarm/env."},
      {"command": "bash install.sh --yes", "purpose": "Unattended install — channels configured via env vars (CRONALARM_DISCORD_WEBHOOK, etc.)."},
      {"command": "cronalarm-report.sh", "purpose": "Daily report. Reads today's log, checks for missed slots, and delivers to the configured channels (inbox always; Discord and/or JSON endpoint on non-green days). Typically run via cron at 11 PM."},
      {"command": "cronalarm-missed-runs.py [--date YYYY-MM-DD] [--json]", "purpose": "Report scheduled cron slots that produced no run at all, from the live crontab + the day's log + the scheduler's service journal. A reader — never triggers or backfills."}
    ],
    "config_env_vars": [
      {"name": "CRONALARM_DIR", "purpose": "Config + log directory. Default: ~/.cronalarm"},
      {"name": "CRONALARM_DISCORD_WEBHOOK", "purpose": "Discord webhook for per-failure alerts. The daily report does NOT use this — see CRONALARM_REPORT_WEBHOOK."},
      {"name": "CRONALARM_MENTION", "purpose": "Optional mention (e.g. '@here') prepended to Discord failure alerts — pair with the channel's 'Only @mentions' setting so only failures make a sound."},
      {"name": "CRONALARM_TIMEOUT", "purpose": "Per-job timeout in seconds. Default 300. Hung jobs get SIGKILLed and alerted."},
      {"name": "CRONALARM_INBOX_DIR", "purpose": "Where local failure reports get dropped. Default: $CRONALARM_DIR/inbox."},
      {"name": "CRONALARM_REPORT_WEBHOOK", "purpose": "Discord webhook for the daily report on non-green days. Separate from the failure-alert webhook so the alert channel stays skim-free. Unset = skipped."},
      {"name": "CRONALARM_BUS_URL", "purpose": "JSON POST endpoint for the daily report on non-green days (message bus / automation). Unset = skipped — the report never POSTs at an empty string."},
      {"name": "CRONALARM_BUS_TO", "purpose": "Recipient field in the JSON payload. Default: ops."},
      {"name": "CRONALARM_GREEN_DIGEST", "purpose": "Where ALL CLEAR days append their one-line digest entry. Default: $CRONALARM_DIR/green-digest.jsonl."},
      {"name": "CRONALARM_REVERIFY_MAP", "purpose": "Tab-separated 'job name<TAB>command' allowlist of read-only checks the report may re-run before composing. Default: $CRONALARM_DIR/reverify.map; absent = nothing re-verified, reds keep their honest stale label."},
      {"name": "CRONALARM_GHA_STATE_FILE", "purpose": "Retention jsonl written by a CI-watching job; enables a GitHub Actions section in the daily report. Unset = section skipped."},
      {"name": "CRONALARM_MISSED_HELPER", "purpose": "Path to cronalarm-missed-runs.py. Default: the copy next to the report script."},
      {"name": "CRONALARM_GHA_WATCH_HHMM", "purpose": "HH:MM schedule of the CI-watching job, used to judge whether the GHA state file is fresh. Unset = entries are quoted with their timestamp instead of judged."},
      {"name": "CRONALARM_CRON_UNIT", "purpose": "systemd unit of the cron scheduler, for missed-run outage attribution. Default cron.service; cronie systems use crond.service. Unknown unit = scheduler state reported as unknown, never guessed."}
    ]
  },

